# Implicit `cd` when typing a directory, and ** recursive globbing
shopt -s autocd globstar 2>/dev/null

# Multi-line commands as one history entry; append instead of overwrite
shopt -s cmdhist histappend

# Skip duplicates and lines starting with a space
export HISTCONTROL="erasedups:ignoreboth"
export HISTIGNORE="&:[ ]*:exit:ls:bg:fg:history"

export HISTSIZE=500000
export HISTFILESIZE=100000
export HISTTIMEFORMAT='%F %T '

# Trim long paths in the prompt
PROMPT_DIRTRIM=2
